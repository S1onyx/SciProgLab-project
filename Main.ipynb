    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# -------------------------------------------------------\n",
    "# Hauptfunktion: Numerische Integration mittels Monte-Carlo-Verfahren\n",
    "# -------------------------------------------------------\n",
    "def monte_carlo_integration(func, a, b, n_punkte=10000, zeige_plot=True,\n",
    "                            explorativ=True, y_unter=None, y_ober=None):\n",
    "    \"\"\"\n",
    "    Schätzt das Integral der Funktion `func` im Intervall [a, b] mithilfe des Monte-Carlo-Verfahrens.\n",
    "    \n",
    "    Parameter:\n",
    "        func        - die zu integrierende Funktion\n",
    "        a, b        - untere und obere Intervallgrenze\n",
    "        n_punkte    - Anzahl zufälliger Punkte für die Schätzung\n",
    "        zeige_plot  - ob ein Plot erzeugt wird\n",
    "        explorativ  - automatische Bestimmung von y_min und y_max (True) oder manuelle Angabe (False)\n",
    "        y_unter     - untere y-Grenze (nur bei explorativ=False)\n",
    "        y_ober      - obere y-Grenze (nur bei explorativ=False)\n",
    "    Rückgabe:\n",
    "        Geschätzter Integralwert\n",
    "    \"\"\"\n",
    "\n",
    "    # Sicherstellen, dass das x-Intervall korrekt definiert ist\n",
    "    if a >= b:\n",
    "        raise ValueError(\"Untere Grenze a muss kleiner als obere Grenze b sein.\")\n",
    "\n",
    "    # ------------------------------\n",
    "    # y-Grenzen bestimmen (explorativ oder manuell)\n",
    "    # ------------------------------\n",
    "    if explorativ:\n",
    "        # Bestimme automatisch min und max der Funktion im Intervall\n",
    "        f_min, f_max = find_extrema(func, a, b)\n",
    "\n",
    "        # Überprüfe auf gültige Funktionswerte\n",
    "        if not np.isfinite(f_min) or not np.isfinite(f_max):\n",
    "            raise ValueError(\"Funktion liefert ungültige Extremwerte.\")\n",
    "\n",
    "        # Begrenze auf die Fläche zwischen Funktion und x-Achse\n",
    "        y_unter = min(f_min, 0)\n",
    "        y_ober = max(f_max, 0)\n",
    "\n",
    "    else:\n",
    "        # Manuelle Festlegung der y-Grenzen erforderlich\n",
    "        if y_unter is None or y_ober is None:\n",
    "            raise ValueError(\"Bei explorativ=False müssen y_unter und y_ober angegeben werden.\")\n",
    "        if y_unter >= y_ober:\n",
    "            raise ValueError(\"y_unter muss kleiner als y_ober sein.\")\n",
    "\n",
    "    # Wenn keine Fläche vorhanden ist, gibt es nichts zu integrieren\n",
    "    if y_unter == y_ober:\n",
    "        return 0.0\n",
    "\n",
    "    # ------------------------------\n",
    "    # Vorbereitung für Visualisierung\n",
    "    # ------------------------------\n",
    "    x_treffer, y_treffer = [], []    # Punkte unter der Kurve\n",
    "    x_verfehlt, y_verfehlt = [] ,[]  # Punkte außerhalb der Kurve\n",
    "\n",
    "    netto_treffer = 0  # Netto-Treffer: positive minus negative Fläche\n",
    "\n",
    "    # ------------------------------\n",
    "    # Monte-Carlo-Simulation\n",
    "    # ------------------------------\n",
    "    for _ in range(n_punkte):\n",
    "        # Zufällige Punktwahl im Rechteck [a, b] × [y_unter, y_ober]\n",
    "        x_rand = np.random.uniform(a, b)\n",
    "        y_rand = np.random.uniform(y_unter, y_ober)\n",
    "\n",
    "        try:\n",
    "            y_func = func(x_rand)\n",
    "            if not np.isfinite(y_func):\n",
    "                continue  # Ignoriere ungültige Funktionswerte\n",
    "        except:\n",
    "            continue  # Ignoriere Fehlerhafte Auswertung\n",
    "\n",
    "        # Fall 1: Punkt liegt im positiven Bereich unterhalb der Funktion\n",
    "        if y_rand >= 0 and 0 <= y_rand <= y_func:\n",
    "            netto_treffer += 1\n",
    "            x_treffer.append(x_rand)\n",
    "            y_treffer.append(y_rand)\n",
    "\n",
    "        # Fall 2: Punkt liegt im negativen Bereich oberhalb der Funktion\n",
    "        elif y_rand < 0 and y_func <= y_rand <= 0:\n",
    "            netto_treffer -= 1\n",
    "            x_treffer.append(x_rand)\n",
    "            y_treffer.append(y_rand)\n",
    "\n",
    "        # Fall 3: Punkt liegt außerhalb der Funktion → zählt nicht\n",
    "        else:\n",
    "            x_verfehlt.append(x_rand)\n",
    "            y_verfehlt.append(y_rand)\n",
    "\n",
    "    # ------------------------------\n",
    "    # Integral berechnen\n",
    "    # ------------------------------\n",
    "    rechteck_flaeche = (b - a) * (y_ober - y_unter)\n",
    "    integral = rechteck_flaeche * (netto_treffer / n_punkte)\n",
    "\n",
    "    # ------------------------------\n",
    "    # Ergebnis-Visualisierung\n",
    "    # ------------------------------\n",
    "    if zeige_plot:\n",
    "        plt.figure(figsize=(8, 5))\n",
    "        xs = np.linspace(a, b, 500)\n",
    "        ys = np.array([func(x) for x in xs])\n",
    "        \n",
    "        plt.plot(xs, ys, label='f(x)', color='black')\n",
    "        plt.axhline(0, color='gray', linestyle='--')  # x-Achse\n",
    "        plt.scatter(x_treffer, y_treffer, s=1, color='green', label='Treffer')\n",
    "        plt.scatter(x_verfehlt, y_verfehlt, s=1, color='red', label='Verfehlt')\n",
    "\n",
    "        plt.title(f\"Numerische Integration mittels Monte-Carlo\\n\"\n",
    "                  f\"Ergebnis bei n={n_punkte} | ≈ {integral:.5f}\")\n",
    "        plt.xlabel(\"x\")\n",
    "        plt.ylabel(\"y\")\n",
    "        plt.legend()\n",
    "        plt.grid(True)\n",
    "        plt.show()\n",
    "\n",
    "    return integral\n",
    "\n",
    "# -------------------------------------------------------\n",
    "# Hilfsfunktion zur Extremwertbestimmung im Intervall\n",
    "# -------------------------------------------------------\n",
    "def find_extrema(func, a, b, n=1000):\n",
    "    \"\"\"\n",
    "    Näherungsweise Bestimmung von Minimum und Maximum der Funktion func im Intervall [a, b].\n",
    "    \n",
    "    Rückgabe: (f_min, f_max)\n",
    "    \"\"\"\n",
    "    xs = np.linspace(a, b, n)\n",
    "    try:\n",
    "        ys = func(xs)  # Versuche direkte Array-Auswertung\n",
    "        ys = np.where(np.isfinite(ys), ys, np.nan)\n",
    "    except:\n",
    "        # Fallback: Einzelne Punkte berechnen\n",
    "        ys = np.array([func(x) if np.isfinite(func(x)) else np.nan for x in xs])\n",
    "    \n",
    "    return np.nanmin(ys), np.nanmax(ys)"
   ]
