    "import unittest\n",
    "import math\n",
    "\n",
    "# -----------------------------------------------\n",
    "# Liste stabiler Testfunktionen für Integrationstests:\n",
    "# Jede Funktion ist gegeben durch:\n",
    "# - Beschreibung (str)\n",
    "# - Funktionsdefinition (lambda x)\n",
    "# - Intervallgrenzen [a, b]\n",
    "# - Analytische Stammfunktion F(x) (lambda x)\n",
    "# -----------------------------------------------\n",
    "testfunktionen_stabil = [\n",
    "    (\"f(x) = -x²\", lambda x: -x**2, -2, 2, lambda x: -(1/3) * x**3),\n",
    "    (\"f(x) = 2x + 1\", lambda x: 2 * x + 1, 0, 1, lambda x: x**2 + x),\n",
    "    (\"f(x) = 5\", lambda x: 5, 2, 6, lambda x: 5 * x),\n",
    "    (\"f(x) = cos(x)\", math.cos, 0, math.pi, lambda x: math.sin(x)),\n",
    "    (\"f(x) = sin(x)\", math.sin, 0, math.pi, lambda x: -math.cos(x)),\n",
    "    (\"f(x) = x²\", lambda x: x**2, 0, 3, lambda x: (1/3) * x**3),\n",
    "    (\"f(x) = x² - 4x + 2\", lambda x: x**2 - 4*x + 2, -3, 3,\n",
    "     lambda x: (1/3)*x**3 - 2*x**2 + 2*x),\n",
    "    (\"f(x) = x·sin(x)\", lambda x: x * math.sin(x), 0, math.pi,\n",
    "     lambda x: -x*math.cos(x)+math.sin(x)),\n",
    "]\n",
    "\n",
    "# -----------------------------------------------\n",
    "# Testklasse für numerische Integrationsmethoden\n",
    "# -----------------------------------------------\n",
    "class TestIntegration(unittest.TestCase):\n",
    "\n",
    "    # Hilfsfunktion zur exakten Berechnung des Integrals mittels F(b) - F(a)\n",
    "    def berechne_exakt(self, f_stamm, a, b):\n",
    "        return f_stamm(b) - f_stamm(a)\n",
    "\n",
    "    # Test: Untersumme\n",
    "    def test_untersumme(self):\n",
    "        for name, f, a, b, f_stamm in testfunktionen_stabil:\n",
    "            with self.subTest(f\"Untersumme: {name}\"):\n",
    "                exakt = self.berechne_exakt(f_stamm, a, b)\n",
    "                # numerische Integration mit Untersumme (n=500 Unterteilungen)\n",
    "                approx = numerische_integration(f, a, b, n=500, methode=\"Untersumme\", zeige_plot=False)\n",
    "                self.assertAlmostEqual(approx, exakt, delta=0.4)\n",
    "\n",
    "    # Test: Obersumme\n",
    "    def test_obersumme(self):\n",
    "        for name, f, a, b, f_stamm in testfunktionen_stabil:\n",
    "            with self.subTest(f\"Obersumme: {name}\"):\n",
    "                exakt = self.berechne_exakt(f_stamm, a, b)\n",
    "                approx = numerische_integration(f, a, b, n=500, methode=\"Obersumme\", zeige_plot=False)\n",
    "                self.assertAlmostEqual(approx, exakt, delta=0.4)\n",
    "\n",
    "    # Test: Trapezregel\n",
    "    def test_trapezregel(self):\n",
