   "outputs": [],
   "source": [
    "from typing import Callable, Tuple\n",
    "from scipy.optimize import minimize_scalar\n",
    "\n",
    "def find_extrema(func: Callable[[float], float], a: float, b: float) -> Tuple[float, float]:\n",
    "    \"\"\"\n",
    "    Findet das Minimum und Maximum der Funktion func im Intervall [a, b].\n",
    "\n",
    "    Rückgabe:\n",
    "        Ein Tupel (f_min, f_max), wobei:\n",
    "        - f_min der kleinste Funktionswert im Intervall ist\n",
    "        - f_max der größte Funktionswert im Intervall ist\n",
    "    \"\"\"\n",
    "    \n",
    "    # Überprüfung: Das Intervall muss gültig sein (a < b)\n",
    "    if a >= b:\n",
    "        raise ValueError(\"Ungültiges Intervall: a muss kleiner als b sein.\")\n",
    "        \n",
    "    # ---------- Minimum berechnen ----------\n",
    "    # Verwende eine numerische Methode (\"bounded\"), um das Minimum von func im Intervall [a, b] zu finden\n",
    "    result_min = minimize_scalar(func, bounds=(a, b), method='bounded')\n",
    "    \n",
    "    # Überprüfung, ob die Optimierung erfolgreich war\n",
    "    if not result_min.success:\n",
    "        raise ValueError(\"Minimum konnte nicht gefunden werden.\")\n",
    "    \n",
    "    # Speichere den gefundenen minimalen Funktionswert\n",
    "    f_min = result_min.fun\n",
    "\n",
    "    # ---------- Maximum berechnen ----------\n",
    "    # Trick: Statt das Maximum direkt zu berechnen, minimieren wir -func(x)\n",
    "    # Dadurch erhalten wir das Maximum von func, weil: max(f(x)) = -min(-f(x))\n",
    "    result_max = minimize_scalar(lambda x: -func(x), bounds=(a, b), method='bounded')\n",
    "    \n",
    "    # Überprüfung, ob die Optimierung erfolgreich war\n",
    "    if not result_max.success:\n",
    "        raise ValueError(\"Maximum konnte nicht gefunden werden.\")\n",
    "    \n",
    "    # Da wir -f(x) minimiert haben, negieren wir das Ergebnis wieder\n",
    "    f_max = -result_max.fun\n",
    "\n",
    "    # Rückgabe des gefundenen Minimums und Maximums als Tupel\n",
    "    return f_min, f_max"
   ]
