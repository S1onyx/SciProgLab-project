    "from typing import Callable, Tuple\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import math\n",
    "from scipy.optimize import minimize_scalar\n",
    "\n",
    "# -------------------------------------------------------\n",
    "# Hilfsfunktion: Sichere Auswertung von Funktionen\n",
    "# -------------------------------------------------------\n",
    "def sicher_auswerten(f: Callable[[float], float], x: float) -> float:\n",
    "    \"\"\"\n",
    "    Führt eine sichere Auswertung der Funktion f an der Stelle x durch.\n",
    "    Fängt typische Fehler wie Division durch Null oder unendliche Werte ab.\n",
    "    \"\"\"\n",
    "    try:\n",
    "        y = f(x)\n",
    "        if not math.isfinite(y):\n",
    "            raise ValueError(f\"f({x}) = {y} ist kein endlicher Wert (NaN oder ∞).\")\n",
    "        return y\n",
    "    except ZeroDivisionError:\n",
    "        raise ValueError(f\"f({x}): Division durch Null.\")\n",
    "    except ValueError as ve:\n",
    "        raise ValueError(f\"f({x}): Ungültiger mathematischer Ausdruck – z. B. Wurzel aus negativer Zahl oder log(≤0): {ve}\")\n",
    "    except Exception as e:\n",
    "        raise ValueError(f\"f({x}): Allgemeiner Fehler bei der Funktionsauswertung: {e}\")\n",
    "\n",
    "# -------------------------------------------------------\n",
    "# Hilfsfunktion: Funktion vektorisieren für NumPy\n",
    "# -------------------------------------------------------\n",
    "def vektorisiere(f: Callable[[float], float]) -> Callable[[np.ndarray], np.ndarray]:\n",
    "    \"\"\"\n",
    "    Wandelt eine skalare Funktion f(x) in eine NumPy-kompatible Funktion um,\n",
    "    sodass ganze Arrays an x-Werten verarbeitet werden können.\n",
    "    \"\"\"\n",
    "    return np.vectorize(lambda x: sicher_auswerten(f, x))\n",
    "\n",
    "# -------------------------------------------------------\n",
    "# Findet Minimum und Maximum im Intervall (für Ober-/Untersumme)\n",
    "# -------------------------------------------------------\n",
    "def find_extrema(func: Callable[[float], float], a: float, b: float) -> Tuple[float, float]:\n",
    "    \"\"\"\n",
    "    Findet das Minimum und Maximum der Funktion func im Intervall [a, b].\n",
    "    Gibt ein Tupel (f_min, f_max) zurück.\n",
    "    \"\"\"\n",
    "    if a >= b:\n",
    "        raise ValueError(\"Ungültiges Intervall: a muss kleiner als b sein.\")\n",
    "        \n",
    "    # Minimum berechnen\n",
    "    result_min = minimize_scalar(func, bounds=(a, b), method='bounded')\n",
    "    if not result_min.success:\n",
    "        raise ValueError(\"Minimum konnte nicht gefunden werden.\")\n",
    "    f_min = result_min.fun\n",
    "\n",
    "    # Maximum berechnen (über -f(x))\n",
    "    result_max = minimize_scalar(lambda x: -func(x), bounds=(a, b), method='bounded')\n",
    "    if not result_max.success:\n",
    "        raise ValueError(\"Maximum konnte nicht gefunden werden.\")\n",
    "    f_max = -result_max.fun\n",
    "\n",
    "    return f_min, f_max\n",
    "\n",
    "# -------------------------------------------------------\n",
    "# Hauptfunktion: Numerische Integration mit drei Verfahren\n",
    "# -------------------------------------------------------\n",
    "def numerische_integration(\n",
    "    f: Callable[[float], float],  # Die zu integrierende Funktion\n",
    "    a: float,                     # Untere Intervallgrenze\n",
    "    b: float,                     # Obere Intervallgrenze\n",
    "    n: int,                       # Anzahl der Teilintervalle\n",
    "    methode: str,                 # \"Untersumme\", \"Obersumme\", \"Trapezregel\"\n",
    "    zeige_plot: bool = True       # Optional: grafische Darstellung\n",
    ") -> float:\n",
    "    \n",
    "    # ---------- Vorbedingungen prüfen ----------\n",
    "    if n <= 0:\n",
    "        raise ValueError(\"Die Anzahl der Unterteilungen (n) muss größer als 0 sein.\")\n",
    "    if a >= b:\n",
    "        raise ValueError(\"Ungültiges Intervall: a muss kleiner als b sein.\")\n",
    "    if not callable(f):\n",
    "        raise ValueError(\"Ungültiges Argument: f muss eine aufrufbare Funktion sein.\")\n",
    "    \n",
    "    deltaX = (b - a) / n                      # Breite eines Teilintervalls\n",
    "    x_i = np.linspace(a, b, n + 1)            # Teilintervallgrenzen (n+1 Punkte)\n",
    "    f_vec = vektorisiere(f)                   # Funktion für Array-Auswertung vorbereiten\n",
    "    summe = 0.0                               # Akkumulator für das Ergebnis\n",
    "\n",
    "    try:\n",
    "        # ---------- Auswahl des Integrationsverfahrens ----------\n",
    "        if methode == \"Untersumme\":\n",
    "            for i in range(n):\n",
    "                f_min, _ = find_extrema(f, x_i[i], x_i[i+1])\n",
    "                summe += f_min * deltaX\n",
    "\n",
    "        elif methode == \"Obersumme\":\n",
    "            for i in range(n):\n",
    "                _, f_max = find_extrema(f, x_i[i], x_i[i+1])\n",
    "                summe += f_max * deltaX\n",
    "\n",
    "        elif methode == \"Trapezregel\":\n",
    "            y_i = f_vec(x_i)  # Funktionswerte an allen x_i\n",
    "            # Trapezregel-Formel: Mittelwert aus benachbarten y-Werten, Randpunkte halb gewichtet\n",
    "            summe = deltaX * (np.sum(y_i) - 0.5 * (y_i[0] + y_i[-1]))\n",
    "\n",
    "        else:\n",
    "            raise ValueError('Ungültige Methode: Erlaubt sind \"Untersumme\", \"Obersumme\" oder \"Trapezregel\".')\n",
    "\n",
    "    except Exception as fehler:\n",
    "        raise fehler\n",
    "\n",
    "    # ---------- Optionale Visualisierung ----------\n",
    "    if zeige_plot:\n",
    "        try:\n",
    "            xs = np.linspace(a, b, 1000)      # Feinere x-Werte zum Zeichnen\n",
    "            ys = f_vec(xs)                    # Funktionswerte zum Zeichnen\n",
    "            fig, ax = plt.subplots(figsize=(8, 5))\n",
    "            ax.plot(xs, ys, label=\"f(x)\", color=\"black\", linewidth=1.5)\n",
    "            ax.axhline(0, color=\"gray\", linestyle=\"--\")\n",
    "\n",
    "            label_gesetzt = False  # Für Legende nur ein Label setzen\n",
    "\n",
    "            if methode == \"Untersumme\":\n",
    "                for i in range(n):\n",
    "                    f_min, _ = find_extrema(f, x_i[i], x_i[i+1])\n",
    "                    ax.bar(x_i[i] + deltaX / 2, f_min, width=deltaX, align='center',\n",
    "                           edgecolor='blue', color='blue', alpha=0.4,\n",
    "                           label='Untersumme' if not label_gesetzt else \"\")\n",
    "                    label_gesetzt = True\n",
    "\n",
    "            elif methode == \"Obersumme\":\n",
    "                for i in range(n):\n",
    "                    _, f_max = find_extrema(f, x_i[i], x_i[i+1])\n",
    "                    ax.bar(x_i[i] + deltaX / 2, f_max, width=deltaX, align='center',\n",
    "                           edgecolor='red', color='red', alpha=0.4,\n",
    "                           label='Obersumme' if not label_gesetzt else \"\")\n",
    "                    label_gesetzt = True\n",
    "\n",
    "            elif methode == \"Trapezregel\":\n",
    "                y_i = f_vec(x_i)\n",
    "                for i in range(n):\n",
    "                    ax.fill([x_i[i], x_i[i], x_i[i+1], x_i[i+1]],\n",
    "                            [0, y_i[i], y_i[i+1], 0],\n",
    "                            color='green', alpha=0.3,\n",
    "                            label='Trapezregel' if not label_gesetzt else \"\")\n",
    "                    label_gesetzt = True\n",
    "\n",
    "            ax.set_title(f\"Numerische Integration mittels {methode}\\n\"\n",
    "                         f\"Ergebnis bei n={n} | ≈ {round(summe, 5)}\")\n",
    "            ax.set_xlabel(\"x\")\n",
    "            ax.set_ylabel(\"y\")\n",
    "            ax.legend()\n",
    "            ax.grid(True)\n",
    "            plt.tight_layout()\n",
    "            plt.show()\n",
    "\n",
    "        except Exception as err:\n",
    "            print(f\"Warnung beim Zeichnen der Funktion: {err}\")\n",
    "\n",
    "    # Rückgabe des gerundeten Integralergebnisses\n",
    "    return round(summe, 3)"
   ]
  },
