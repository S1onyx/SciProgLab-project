   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import ipywidgets as widgets\n",
    "\n",
    "# Verschiedene Funktionen als Auswahl\n",
    "funktions_dict = {\n",
    "    \"x²\": lambda x: x**2,\n",
    "    \"sin(x)\": np.sin,\n",
    "    \"e^x\": np.exp,\n",
    "    \"ln(x+1)\": lambda x: np.log(x+1),\n",
    "    \"1/(1+x²)\": lambda x: 1/(1 + x**2),\n",
    "}\n",
    "\n",
    "def monte_carlo_interactive(a, b, n_points, func_name):\n",
    "    # Funktion auswählen\n",
    "    f = funktions_dict[func_name]\n",
    "    x = np.linspace(a, b, 1000)\n",
    "    y = f(x)\n",
    "\n",
    "    # Höhe des Sampling-Rechtecks leicht über Funktionsmaximum\n",
    "    ymax = y.max() * 1.1\n",
    "\n",
    "    # Zufallspunkte generieren\n",
    "    xs = np.random.uniform(a, b, n_points)\n",
    "    ys = np.random.uniform(0, ymax, n_points)\n",
    "    # Prüfen, welche Punkte unter der Kurve liegen\n",
    "    unter_kurve = ys < f(xs)\n",
    "\n",
    "    # Plot\n",
    "    plt.figure(figsize=(6,4))\n",
    "    plt.plot(x, y, label=f'f(x)={func_name}', color='black')\n",
    "    plt.scatter(xs[unter_kurve], ys[unter_kurve], s=8, color='green', alpha=0.6, label='Treffer (unter Kurve)')\n",
    "    plt.scatter(xs[~unter_kurve], ys[~unter_kurve], s=8, color='red', alpha=0.3, label='Verfehlt (über Kurve)')\n",
    "    plt.ylim(0, ymax)\n",
    "    plt.legend()\n",
    "    plt.title(f\"Monte-Carlo-Integration für f(x)={func_name}, Punkte: {n_points}\")\n",
    "    plt.xlabel(\"x\")\n",
    "    plt.ylabel(\"y\")\n",
    "    plt.show()\n",
    "\n",
    "## Ergebnis\n",
    "\n",
    "# Widget mit Auswahl für Intervall, Punktzahl und Funktion\n",
    "widgets.interactive(\n",
    "    monte_carlo_interactive,\n",
    "    a=widgets.FloatSlider(min=0, max=3, step=0.1, value=0, description=\"a (links)\"),\n",
    "    b=widgets.FloatSlider(min=0.5, max=5, step=0.1, value=2, description=\"b (rechts)\"),\n",
    "    n_points=widgets.IntSlider(min=100, max=5000, step=100, value=1000, description=\"Punkte\"),\n",
    "    func_name=widgets.Dropdown(options=list(funktions_dict.keys()), value=\"x²\", description=\"f(x)\")\n",
    ")\n"
   ]
