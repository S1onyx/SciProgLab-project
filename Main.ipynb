    "# Interaktives Widget zur Visualisierung numerischer Integration\n",
    "# Einfach und selbsterklärend, mit Kommentaren zum Vorstellen!\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import ipywidgets as widgets\n",
    "\n",
    "# Auswahl verschiedener Beispiel-Funktionen\n",
    "funktions_dict = {\n",
    "    \"x²\": lambda x: x**2,\n",
    "    \"sin(x)\": np.sin,\n",
    "    \"e^x\": np.exp,\n",
    "    \"ln(x+1)\": lambda x: np.log(x+1),\n",
    "    \"1/(1+x²)\": lambda x: 1/(1 + x**2),\n",
    "}\n",
    "\n",
    "def plot_integrationsmethoden(a, b, n, method, func_name):\n",
    "    # Funktion auswählen\n",
    "    f = funktions_dict[func_name]\n",
    "    # X-Werte für Plot\n",
    "    x = np.linspace(a, b, 1000)\n",
    "    y = f(x)\n",
    "    # Stützstellen für Rechtecke/Trapeze\n",
    "    xs = np.linspace(a, b, n+1)\n",
    "    dx = (b - a) / n\n",
    "\n",
    "    plt.figure(figsize=(6,4))\n",
    "    plt.plot(x, y, label=f'f(x)={func_name}', color='black')\n",
    "\n",
    "    # Visualisierung je nach Methode\n",
    "    if method == \"Untersumme\":\n",
    "        # Für jedes Intervall: Minimum links/rechts, ergibt das Rechteck (Untersumme)\n",
    "        ys = np.minimum(f(xs[:-1]), f(xs[1:]))\n",
    "        plt.bar(xs[:-1], ys, width=dx, alpha=0.3, color='red', align='edge', label='Untersumme')\n",
    "    elif method == \"Obersumme\":\n",
    "        ys = np.maximum(f(xs[:-1]), f(xs[1:]))\n",
    "        plt.bar(xs[:-1], ys, width=dx, alpha=0.3, color='blue', align='edge', label='Obersumme')\n",
    "    elif method == \"Trapezregel\":\n",
    "        # Trapeze zwischen benachbarten Stützstellen\n",
    "        for i in range(n):\n",
    "            plt.fill_between([xs[i], xs[i+1]], [f(xs[i]), f(xs[i+1])], alpha=0.3, color='green')\n",
    "        plt.plot(xs, f(xs), 'go', label='Stützstellen')\n",
    "\n",
    "    plt.legend()\n",
    "    plt.title(f\"{method} von f(x)={func_name} auf [{a}, {b}] mit n={n}\")\n",
    "    plt.xlabel(\"x\")\n",
    "    plt.ylabel(\"f(x)\")\n",
    "    plt.show()\n",
    "\n",
    "# Widget für Interaktivität\n",
    "widgets.interactive(\n",
    "    plot_integrationsmethoden,\n",
    "    a=widgets.FloatSlider(min=0, max=3, step=0.1, value=0, description=\"a (links)\"),\n",
    "    b=widgets.FloatSlider(min=0.5, max=5, step=0.1, value=2, description=\"b (rechts)\"),\n",
    "    n=widgets.IntSlider(min=2, max=50, step=1, value=10, description=\"Anzahl n\"),\n",
    "    method=widgets.RadioButtons(options=[\"Untersumme\", \"Obersumme\", \"Trapezregel\"], description=\"Methode\"),\n",
    "    func_name=widgets.Dropdown(options=list(funktions_dict.keys()), value=\"x²\", description=\"f(x)\")\n",
    ")\n"
   ]
  },
