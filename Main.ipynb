    "from typing import Callable, List, Tuple\n",
    "import math\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "# -------------------------------------------------------\n",
    "# Hauptfunktion zur Auswertung numerischer Integrationsverfahren\n",
    "# -------------------------------------------------------\n",
    "def auswertung_durchfuehren(\n",
    "    nutze_feste_grenzen: bool,  # True = für alle Funktionen dieselben Integrationsgrenzen verwenden\n",
    "    feste_a: float,             # Feste untere Intervallgrenze\n",
    "    feste_b: float,             # Feste obere Intervallgrenze\n",
    "    moFaktor: int,              # Multiplikator für die Anzahl Monte-Carlo-Stichproben pro n\n",
    "    max_n: int,                 # Maximale Anzahl von Teilintervallen\n",
    "    testfunktionen: List[Tuple[str, Callable[[float], float], float, float, Callable[[float], float]]],\n",
    "):\n",
    "    # Farbdefinitionen für die Diagramm-Linien\n",
    "    farben = {\n",
    "        \"Untersumme\": \"#f94144\",\n",
    "        \"Obersumme\": \"#f3722c\",\n",
    "        \"Trapezregel\": \"#90be6d\",\n",
    "        \"Exakt\": \"#577590\",\n",
    "        \"Montecarlo\": \"#277da1\"\n",
    "    }\n",
    "\n",
    "    fehlgeschlagene_funktionen = []  # Sammelliste für Funktionen, bei denen Fehler auftreten\n",
    "\n",
    "    # ------------------------------\n",
    "    # Iteration über alle Testfunktionen\n",
    "    # ------------------------------\n",
    "    for name, f, a, b, F in testfunktionen:\n",
    "        # Wähle je nach Einstellung feste oder funktionsspezifische Grenzen\n",
    "        a_aktuell, b_aktuell = (feste_a, feste_b) if nutze_feste_grenzen else (a, b)\n",
    "\n",
    "        Ns = list(range(1, max_n+1))  # Liste der zu testenden Teilintervalle n = 1 bis max_n\n",
    "        untersummen, obersummen, trapezwerte, montecarlo = [], [], [], []  # Ergebnislisten\n",
    "        funktion_ist_gefailt = False\n",
    "        fehler_begruendung = \"\"\n",
    "\n",
    "        # Versuche exakten Wert über Stammfunktion (falls vorhanden) zu berechnen\n",
    "        try:\n",
    "            exaktwert = None if F is None else F(b_aktuell) - F(a_aktuell)\n",
    "        except Exception as e:\n",
    "            exaktwert = None\n",
    "            funktion_ist_gefailt = True\n",
    "            fehler_begruendung = f\"Fehler bei exakter Berechnung: {e}\"\n",
    "\n",
    "        # ------------------------------\n",
    "        # Berechnung für verschiedene n\n",
    "        # ------------------------------\n",
    "        for n in Ns:\n",
    "            zeige_plot = (n == 20)  # Optional: Detaillierter Einzelplot bei n = 20\n",
    "\n",
    "            # Untersumme\n",
    "            try:\n",
    "                us = numerische_integration(f, a_aktuell, b_aktuell, n, \"Untersumme\", zeige_plot=zeige_plot)\n",
    "            except Exception as e:\n",
    "                us = None\n",
    "                funktion_ist_gefailt = True\n",
    "                if not fehler_begruendung:\n",
    "                    fehler_begruendung = f\"Fehler bei Untersumme (n={n}): {e}\"\n",
    "\n",
    "            # Obersumme\n",
    "            try:\n",
    "                os = numerische_integration(f, a_aktuell, b_aktuell, n, \"Obersumme\", zeige_plot=zeige_plot)\n",
    "            except Exception as e:\n",
    "                os = None\n",
    "                funktion_ist_gefailt = True\n",
    "                if not fehler_begruendung:\n",
    "                    fehler_begruendung = f\"Fehler bei Obersumme (n={n}): {e}\"\n",
    "\n",
    "            # Trapezregel\n",
    "            try:\n",
    "                tr = numerische_integration(f, a_aktuell, b_aktuell, n, \"Trapezregel\", zeige_plot=zeige_plot)\n",
    "            except Exception as e:\n",
    "                tr = None\n",
    "                funktion_ist_gefailt = True\n",
    "                if not fehler_begruendung:\n",
    "                    fehler_begruendung = f\"Fehler bei Trapezregel (n={n}): {e}\"\n",
    "\n",
    "            # Monte-Carlo-Integration\n",
    "            try:\n",
    "                mo = monte_carlo_integration(f, a_aktuell, b_aktuell, n_punkte=n * moFaktor, zeige_plot=zeige_plot, explorativ=True)\n",
    "            except Exception as e:\n",
    "                mo = None\n",
    "                funktion_ist_gefailt = True\n",
    "                if not fehler_begruendung:\n",
    "                    fehler_begruendung = f\"Fehler bei Monte-Carlo (n={n}): {e}\"\n",
    "\n",
    "            # Ergebnisse speichern\n",
    "            untersummen.append(us)\n",
    "            obersummen.append(os)\n",
    "            trapezwerte.append(tr)\n",
    "            montecarlo.append(mo)\n",
    "\n",
    "        # ------------------------------\n",
    "        # Prüfung: Hat mindestens eine Methode funktioniert?\n",
    "        # ------------------------------\n",
    "        mindestens_ein_wert = any(v is not None for v in untersummen + obersummen + trapezwerte + montecarlo)\n",
    "        if not mindestens_ein_wert:\n",
    "            fehlgeschlagene_funktionen.append((name, fehler_begruendung or \"Alle Methoden fehlgeschlagen.\"))\n",
    "            continue\n",
    "\n",
    "        # ------------------------------\n",
    "        # Visualisierung des Vergleichs\n",
    "        # ------------------------------\n",
    "        plt.figure(figsize=(9, 5))\n",
    "\n",
    "        # Hilfsfunktion: Ersetzt None durch NaN, damit matplotlib korrekt plottet\n",
    "        def safe_plot(x, y, label, color):\n",
    "            y_valid = [v if v is not None else np.nan for v in y]\n",
    "            plt.plot(x, y_valid, label=label, color=color)\n",
    "\n",
    "        # Plotte alle vier Methoden\n",
    "        safe_plot(Ns, untersummen, \"Untersumme\", farben[\"Untersumme\"])\n",
    "        safe_plot(Ns, obersummen, \"Obersumme\", farben[\"Obersumme\"])\n",
    "        safe_plot(Ns, trapezwerte, \"Trapezregel\", farben[\"Trapezregel\"])\n",
    "        safe_plot(Ns, montecarlo, f\"Monte-Carlo [n*{moFaktor}]\", farben[\"Montecarlo\"])\n",
    "\n",
    "        # Plotte exakten Wert, falls vorhanden\n",
    "        if exaktwert is not None:\n",
    "            plt.hlines(exaktwert, min(Ns), max(Ns), label=\"Exakter Wert\", color=farben[\"Exakt\"], linestyle=\"dashed\")\n",
    "\n",
    "        # Beschriftung und Design\n",
    "        plt.title(f\"{name} auf [{a_aktuell}, {b_aktuell}]\")\n",
    "        plt.xlabel(\"Anzahl Teilintervalle (n)\")\n",
    "        plt.ylabel(\"Flächeninhalt\")\n",
    "        plt.legend()\n",
    "        plt.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "\n",
    "        # Dynamische y-Achsen-Skalierung basierend auf gültigen Werten\n",
    "        y_werte = [v for v in untersummen + obersummen + trapezwerte + montecarlo if isinstance(v, (int, float)) and not np.isnan(v)]\n",
    "        if y_werte:\n",
    "            y_min, y_max = min(y_werte), max(y_werte)\n",
    "            plt.ylim(y_min - 0.1 * abs(y_max), y_max + 0.1 * abs(y_max))\n",
    "\n",
    "        # Exakten Wert als Text einblenden\n",
    "        if exaktwert is not None:\n",
    "            plt.text(max(Ns), exaktwert, f\"{exaktwert:.5f}\", color=farben[\"Exakt\"],\n",
    "                     fontsize=10, ha=\"right\", va=\"bottom\",\n",
    "                     bbox=dict(facecolor='white', alpha=0.6, edgecolor='gray'))\n",
    "\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "    # ------------------------------\n",
    "    # Zusammenfassung fehlerhafter Funktionen\n",
    "    # ------------------------------\n",
    "    if fehlgeschlagene_funktionen:\n",
    "        print(\"\\nFehlgeschlagene Funktionen:\")\n",
    "        for name, grund in fehlgeschlagene_funktionen:\n",
    "            print(f\"– {name}: {grund}\")\n",
    "    else:\n",
    "        print(\"\\nAlle Funktionen erfolgreich geplottet.\")"
   ]
