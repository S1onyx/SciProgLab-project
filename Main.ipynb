   "source": [
    "# ---------------------------------------------------------------\n",
    "# Testfunktion: Gaußsche Glockenkurve (Standard-Gauss-Funktion)\n",
    "# ---------------------------------------------------------------\n",
    "GausscheGlockenKurve = [\n",
    "    (\n",
    "        # Funktionsname (wird in Plots und Legenden verwendet)\n",
    "        \"f(x) = e^{-x^2}\",\n",
    "\n",
    "        # Funktionsdefinition: f(x) = e^(-x²)\n",
    "        # Symmetrische, glockenförmige Funktion mit Maximum bei x = 0\n",
    "        # Wird häufig in Statistik (Normalverteilung), Physik und Signalverarbeitung verwendet\n",
    "        lambda x: math.exp(-x**2),\n",
    "\n",
    "        # Untere und obere Integrationsgrenze\n",
    "        -2,  # Links von 0\n",
    "        2,   # Rechts von 0\n",
    "\n",
    "        # Stammfunktion:\n",
    "        # ∫ e^(-x²) dx = (√π / 2) * erf(x)\n",
    "        # (Die Fehlerfunktion erf(x) ist in math.erf verfügbar)\n",
    "        lambda x: (math.sqrt(math.pi) / 2) * math.erf(x)\n",
    "    ),\n",
    "]"
   ]
